# Copy to .env.local for local builds, or set these in Vercel > Project > Settings > Environment Variables.
# Everything prefixed VITE_ is compiled into the public JavaScript: never put secrets here.

# Public site address, used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# On Vercel this falls back to the production domain automatically if left empty.
SITE_URL=https://www.example.com

# Enquiry form (contact.html). Set ONE of these.
# 1) A form service endpoint that accepts POST (for example a Formspree form URL):
VITE_ENQUIRY_ENDPOINT=
# 2) Or an email address: the visitor's email app opens with the enquiry filled in.
VITE_ENQUIRY_EMAIL=
