{
  "name": "the-unfound-chapter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Unfound Chapter: curated journeys and meaningful experiences across India.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "serve:prod": "node scripts/serve-static.mjs dist 4175 --vercel",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e.spec.js",
    "test:visual": "playwright test tests/visual.spec.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource/brygada-1918": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "@fontsource/italianno": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@vitejs/plugin-react": "6.1.2",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "vite": "8.3.5"
  }
}
